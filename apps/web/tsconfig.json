{
  "extends": "@cdv/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023", "WebWorker"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "types": ["node", "@serwist/next/typings"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "public/sw.js"]
}
