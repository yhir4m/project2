# ---------------------------------------------------------------------------
# Copia este archivo a apps/web/.env.local y llena los valores. NUNCA subas .env.local.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
DEMO_MODE=true

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pey (https://portal.mipey.mx → Desarrollador). Solo producción.
MODO_PRUEBA=true
MONTO_PRUEBA_MXN=0.10
PEY_API_KEY=
PEY_WEBHOOK_SECRET=whsec_...
# Opt-in para desarrollar sin API key (no se mueve dinero):
PEY_SIMULADO=false

# xAI (Grok con visión). Sin llave, los documentos van a revisión manual.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Secreto HS256 del token de verificación de escaneo (openssl rand -base64 48)
VERIFICACION_SECRET=

# Llaves Ed25519 por emisor (pnpm keys:generate -- uttab inapam)
ISSUER_UTTAB_PRIVATE_KEY=
ISSUER_UTTAB_PUBLIC_KEY=
ISSUER_INAPAM_PRIVATE_KEY=
ISSUER_INAPAM_PUBLIC_KEY=
