{
  "name": "cobro-descuento-verificado",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cdv/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate": "pnpm --filter @cdv/core keys:generate"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
